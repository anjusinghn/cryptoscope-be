# Cryptoscope Backend - Example Environment
# Copy to .env and adjust values as needed.

# Service
PORT=5050
CORS_ORIGINS=http://localhost:3000

# Scanner provider
# Options: manual, semgrep
SCANNER=manual
SCAN_CONCURRENCY=1
SCAN_MAX_FILES=2000

# Indexing & embeddings (turn off for low-memory deployments)
DISABLE_INDEXING=1
EMBEDDING_DISABLED=1
# If you run embeddings remotely, set EMBEDDING_API_URL and unset EMBEDDING_DISABLED
# EMBEDDING_API_URL=https://your-embedding-service/embeddings
# EMBEDDING_MODEL=Xenova/e5-small-v2
# EMBEDDING_MODEL_PATH=./models/e5-small-v2
# EMBEDDING_QUANTIZED=true

# Data directories (override in container to use mounted disk)
CRYPTOSCOPE_DATA_DIR=./data
LANCEDB_DIR=./lancedb

# Upload limits
ZIP_MAX_BYTES=83886080

# Optional LLM integration (Groq)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-70b-versatile
# GROQ_ENRICH_MODEL=
